# DX (Datacloud) API token used as the Bearer credential.
DATACLOUD_API_TOKEN=your-api-token-here

# Base URL of your DX instance. The pipelineRuns.upsert path is appended automatically.
DATACLOUD_BASE_URL=https://your-instance.getdx.net

# Optional: drop-in directory scanned for *.csv when no paths are passed.
# Defaults to ./data
# DATACLOUD_CSV_DIR=data
